# ===== 服务 =====
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ===== 数据库 =====
# SQLite（默认，零配置）
DATABASE_URL="file:./dev.db"
# PostgreSQL（生产）：把 provider 改为 postgresql 即可，业务代码零改动
# DATABASE_URL="postgresql://user:password@localhost:5432/cyberfish_admin?schema=public"

# ===== 鉴权 =====
JWT_SECRET=cyberfish-admin-dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# ===== 文件存储 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=209715200

# ===== 日志 =====
LOG_LEVEL=info

# ===== APP 端调用令牌（客户端 OTA / 上报使用，与后台 JWT 隔离）=====
APP_API_TOKEN=cyberfish-app-token-dev
INVITE_CODE_SECRET=cyberfish-invite-secret-change-me

# ===== 安全迁移开关（生产必须显式设置，迁移完成后关闭）=====
DEVICE_AUTH_DUAL_MODE=true
SECURITY_MIGRATION_MODE=true
MODEL_CONTAINER_V2_ENABLED=false
MODEL_LEGACY_V1_ALLOWED=true
MODEL_MANIFEST_SIGNING_KEY_ID=
# MODEL_MANIFEST_SIGNING_PRIVATE_KEY_B64=<仅生产 secret，不写入仓库>

# ===== 前端开发代理 =====
CORS_ORIGIN=http://localhost:5173
